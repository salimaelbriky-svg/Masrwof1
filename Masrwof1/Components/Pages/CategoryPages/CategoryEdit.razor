@page "/category/edit/{id:guid}"

@using Masrwof1.Models
@using Masrwof1.Interfaces

@inject ICategoryServise CategoryServise
@inject NavigationManager Navigation

<div class="expense-form-container">
    <EditForm Model="@category" OnValidSubmit="HandelSubmit">
        <DataAnnotationsValidator />

        <div class="expense-form-group">
            <label class="expense-form-label">الفئة</label>
            <input type="text" class="expense-form-input" @bind="category.Name" required />
        </div>

        <div class="expense-actions">
            <button type="submit" class="expense-btn expense-btn-primary">حفظ</button>
            <button type="button" class="expense-btn" @onclick="GoBack">إلغاء</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public Guid id { get; set; }
    private Category category = new();
    protected override void OnInitialized()
    {
        category = CategoryServise.GetCategoryById(id) ?? new();
        if( category.Id == Guid.Empty)
        {
            Navigation.NavigateTo("/categorylist");
        }
    }
    private void HandelSubmit()
    {
        CategoryServise.updateCategory(category);
        GoBack();

    }
    private void GoBack()
    {
        Navigation.NavigateTo("/categorylist");
    }

}
